# OMNISCIENT AI — Environment Configuration Template
# Copy this file to .env and add your API keys.
# Never commit .env containing real secrets to version control.

ACTIVE_LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

IMAGE_GENERATION_API_KEY=
WEB_SEARCH_API_KEY=

# Optional PostgreSQL connection string (defaults to local SQLite omniscient.db if empty)
DATABASE_URL=

# Optional MongoDB connection URI (defaults to local schema-validated document store if empty)
MONGODB_URI=
MONGODB_DB_NAME=omniscient_ai
